// ─────────────────────────────────────────────────────────────
// DB 스키마 = "어떤 테이블에 어떤 컬럼이 있고, 서로 어떻게 연결되는가"
// 이 파일을 고친 뒤 `pnpm db:migrate`를 실행하면
//   1) SQL 마이그레이션 파일이 prisma/migrations에 생성되고
//   2) 실제 DB에 적용되고
//   3) 타입이 붙은 Prisma Client가 src/generated/prisma에 다시 만들어집니다.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // NestJS는 CommonJS로 돌기 때문에 생성 코드도 CJS로 맞춥니다. (Prisma 7 기본값은 ESM)
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// 전시회 1개 = 행 1개
model Exhibition {
  id               Int           @id @default(autoincrement())
  name             String
  venue            String
  startDate        DateTime
  endDate          DateTime
  // 신청 마감일. 이 날짜가 지나면 서버가 신청을 거절합니다.
  applyDeadline    DateTime
  // 부스 1칸 가격(원). 돈은 소수점 오차가 없도록 정수(원 단위)로 저장합니다.
  boothPrice       Int
  // 판매 가능한 전체 부스 수. "남은 부스"는 저장하지 않고 신청 내역으로 계산합니다.
  // ⚠️ 남은 수량을 별도 컬럼으로 두면, 신청/취소 때마다 두 곳을 같이 고쳐야 해서 어긋나기 쉽습니다.
  totalBooths      Int
  applications     Application[] // 1:N 관계 — 전시회 1개에 신청 여러 개
  createdAt        DateTime      @default(now())
}

enum ApplicationStatus {
  PENDING   // 접수됨 (결제/승인 전)
  CONFIRMED // 확정
  CANCELLED // 취소 — 행을 지우지 않고 상태만 바꿉니다(이력 보존).
}

// 참가 신청 1건 = 행 1개
model Application {
  id            Int               @id @default(autoincrement())
  exhibition    Exhibition        @relation(fields: [exhibitionId], references: [id])
  exhibitionId  Int               // 외래키(FK): 어떤 전시회에 대한 신청인지
  // 누가 신청했는지. 2단계부터 로그인한 사용자만 신청할 수 있고, 본인 것만 조회·취소합니다.
  user          User              @relation(fields: [userId], references: [id])
  userId        Int
  companyName   String
  contactName   String
  contactEmail  String
  boothCount    Int
  // 신청 시점의 가격을 박제합니다. 나중에 전시회 가격이 바뀌어도 이미 신청한 금액은 그대로여야 하니까요.
  totalPrice    Int
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime          @default(now())

  // "이 전시회의 신청 목록", "내 신청 목록" 조회가 잦으므로 인덱스를 둡니다.
  @@index([exhibitionId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// 2단계: 인증
// ─────────────────────────────────────────────────────────────

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique // 같은 이메일로 두 번 가입 못 하도록 DB가 보장
  // ⚠️ 비밀번호 원문은 절대 저장하지 않습니다. 단방향 해시(scrypt)만 저장합니다.
  //    DB가 유출돼도 원래 비밀번호를 알아낼 수 없게 하려는 것.
  passwordHash  String
  name          String
  applications  Application[]
  refreshTokens RefreshToken[]
  createdAt     DateTime       @default(now())
}

// 리프레시 토큰을 DB에 저장하는 이유:
//   JWT는 서버가 "발급 후 취소"를 못 합니다(만료 전까지 유효). 그래서
//   - 액세스 토큰은 15분으로 짧게 → 유출돼도 피해 시간이 짧음
//   - 리프레시 토큰은 DB에 기록 → 로그아웃·탈취 의심 시 서버가 무효화할 수 있음
// ⚠️ 토큰 원문이 아니라 해시만 저장합니다(비밀번호와 같은 이유).
model RefreshToken {
  id         Int       @id @default(autoincrement())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  // 사용(회전)되거나 로그아웃되면 시각을 기록. null이면 아직 쓸 수 있는 토큰.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}
